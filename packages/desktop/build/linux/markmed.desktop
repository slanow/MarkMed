[Desktop Entry]
Name=MarkMed
Comment=Next generation markdown editor
Exec=markmed %F
Terminal=false
Type=Application
Icon=markmed
Categories=Office;TextEditor;Utility;
MimeType=text/markdown;
Keywords=markmed;
StartupWMClass=markmed
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=markmed --new-window %F
Icon=markmed
